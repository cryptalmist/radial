{
  "schemaVersion": 1,
  "id": "radial",
  "version": "${version}",
  "name": "radial",
  "description": "A simple and opinionated Minecraft radial menu mod that works flawlessly out of the box.",
  "authors": [
    {
      "name": "velolib",
      "contact": {
        "email": "vlocitize@gmail.com",
        "homepage": "https://velolib.dev"
      }
    }
  ],
  "contact": {
    "sources": "https://github.com/velolib/radial",
    "issues": "https://github.com/velolib/radial/issues",
    "homepage": "https://modrinth.com/mod/radial"
  },
  "license": "GPL-3.0",
  "icon": "assets/radial/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.velolib.radial.RadialClient"
    ],
    "modmenu": [
      "dev.velolib.radial.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "radial.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "yet_another_config_lib_v3": ">=3.8.2+1.21.11-fabric",
    "modmenu": ">=17.0.0",
    "malilib": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/radial",
        "modmenu.github_releases": "https://github.com/velolib/radial/releases",
        "modmenu.issues": "https://github.com/velolib/radial/issues"
      }
    }
  },
  "accessWidener": "radial.accesswidener"
}